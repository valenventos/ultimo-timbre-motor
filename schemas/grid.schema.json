{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimotimbre.ar/schemas/grid/v1.json",
  "title": "Grilla salarial aprobada",
  "description": "Valores de los cargos con su procedencia y su aprobador (FR-008, Principio IX). El valor de un cargo no es un importe único: es un conjunto de componentes, porque la antigüedad se aplica solo sobre los bonificables (FR-031a, FR-031b).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "norma",
    "vigencia_desde",
    "extraida_en",
    "aprobada_por",
    "aprobada_en",
    "valores"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "ficticia": {
      "type": "boolean",
      "default": false,
      "description": "true solo en las grillas de prueba de tests/fixtures/. El loader de grids/ rechaza toda grilla con este campo en true: un informe real valuado con importes inventados es el peor resultado posible del motor."
    },
    "norma": { "$ref": "#/$defs/norma" },
    "enlace": { "type": ["string", "null"] },
    "vigencia_desde": { "type": "string", "format": "date" },
    "vigencia_hasta": { "type": ["string", "null"], "format": "date" },
    "extraida_en": { "type": "string", "format": "date" },
    "aprobada_por": { "type": "string", "minLength": 1 },
    "aprobada_en": { "type": "string", "format": "date" },
    "valores": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/componente" }
      }
    }
  },
  "$defs": {
    "norma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texto", "ley"],
      "properties": {
        "texto": { "type": "string", "minLength": 1 },
        "ley": { "type": "string", "minLength": 1 },
        "articulo": { "type": ["string", "null"] },
        "inciso": { "type": ["string", "null"] },
        "enlace": { "type": ["string", "null"] }
      }
    },
    "componente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo_concepto", "descripcion", "importe", "bonificable", "remunerativo"],
      "properties": {
        "codigo_concepto": { "type": "string", "minLength": 1 },
        "descripcion": { "type": "string", "minLength": 1 },
        "importe": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "String numérico, nunca number (research R1)."
        },
        "bonificable": {
          "type": "boolean",
          "description": "Si la antigüedad se aplica sobre este componente (FR-031b)."
        },
        "remunerativo": { "type": "boolean" },
        "regla_id": { "type": ["string", "null"] }
      }
    }
  }
}
